rules_version = '2';

// Who can read and write what, checked by Google's servers on every request.
// The site asks only for what you may see, but these rules are what actually
// keep the surprise: even someone poking at the site with developer tools
// can't read a gift, a claim or an overheard note about themselves.
//
// The family list is the `members` collection: one document per email
// (lowercase, as the document's name) with `personId` saying who that is.
// Brady adds people there by hand in the Firebase console, always after
// their sign-in account exists. Nobody can change
// members, people or homes from the site.
//
// To publish a change: Firebase console > Firestore > Rules, paste this whole
// file, Publish. Test first with `npm run test:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who's asking ----

    // Signed in with an email that's really theirs: Google checked it, or it's
    // a family password account. A password account's email isn't checked, so
    // it's safe only because every family email gets its account BEFORE its
    // members entry: nobody else can make an account with that email after
    // that (Firebase allows one account per email). See FIREBASE-SETUP.md.
    function signedIn() {
      return request.auth != null
        && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function memberDoc() {
      return /databases/$(database)/documents/members/$(request.auth.token.email.lower());
    }

    function isFamily() {
      return signedIn() && exists(memberDoc());
    }

    // The person (people/{id}) the signed-in email belongs to.
    function me() {
      return get(memberDoc()).data.personId;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---- What a record may hold ----
    // Only the fields the site writes, of the right kind. A gift or note must
    // be about a real person: one for "April" instead of "april" would be
    // about nobody, so April could read it.

    function isPerson(id) {
      return id is string && exists(/databases/$(database)/documents/people/$(id));
    }

    function isHome(id) {
      return id is string && exists(/databases/$(database)/documents/homes/$(id));
    }

    function text(value, longest) {
      return value is string && value.size() > 0 && value.size() <= longest;
    }

    // A field that can be left out, or a string up to `longest` characters.
    function maybeText(data, field, longest) {
      return !(field in data) || (data[field] is string && data[field].size() <= longest);
    }

    function validWish(d) {
      return d.keys().hasAll(['ownerId', 'kind', 'title', 'topPick', 'order', 'createdAt'])
        && d.keys().hasOnly(['ownerId', 'kind', 'title', 'link', 'notes', 'price', 'topPick', 'order', 'createdAt'])
        && d.kind in ['specific', 'maybe']
        && text(d.title, 500)
        && maybeText(d, 'link', 4000)
        && maybeText(d, 'notes', 5000)
        && maybeText(d, 'price', 100)
        && d.topPick is bool
        && d.order is number
        && text(d.createdAt, 40);
    }

    function validGift(d) {
      return d.keys().hasAll(['recipientId', 'giverId', 'title', 'place', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.keys().hasOnly(['recipientId', 'giverId', 'title', 'wishItemId', 'link', 'notes', 'place', 'shipTo', 'createdAt', 'updatedAt', 'updatedBy'])
        && isPerson(d.recipientId)
        && isPerson(d.giverId)
        && d.giverId != d.recipientId
        && text(d.title, 500)
        && d.place in ['tree', 'stocking']
        && maybeText(d, 'wishItemId', 100)
        && maybeText(d, 'link', 4000)
        && maybeText(d, 'notes', 5000)
        && (!('shipTo' in d) || isHome(d.shipTo))
        && text(d.createdAt, 40)
        && text(d.updatedAt, 40);
    }

    function validIdea(d) {
      return d.keys().hasAll(['aboutId', 'authorId', 'text', 'createdAt'])
        && d.keys().hasOnly(['aboutId', 'authorId', 'text', 'createdAt', 'madeIntoGift'])
        && isPerson(d.aboutId)
        && text(d.text, 2000)
        && (!('madeIntoGift' in d) || d.madeIntoGift is bool)
        && text(d.createdAt, 40);
    }

    // ---- Set up by Brady in the console ----

    match /members/{email} {
      // You can look yourself up, nobody else.
      allow read: if signedIn() && email == request.auth.token.email.lower();
      allow write: if false;
    }

    match /people/{personId} {
      allow read: if isFamily();
      allow write: if false;
    }

    match /homes/{homeId} {
      allow read: if isFamily();
      allow write: if false;
    }

    // ---- Written on the site ----

    // Your own list. Everyone sees wishes; who's getting what is in gifts.
    match /wishes/{wishId} {
      allow read: if isFamily();
      allow create: if isFamily() && request.resource.data.ownerId == me() && validWish(request.resource.data);
      allow update: if isFamily() && resource.data.ownerId == me() && unchanged('ownerId') && validWish(request.resource.data);
      allow delete: if isFamily() && resource.data.ownerId == me();
    }

    // Gifts, including claims on someone's list. Never for the person they're for.
    match /gifts/{giftId} {
      allow read: if isFamily() && resource.data.recipientId != me();
      allow create: if isFamily()
        && request.resource.data.recipientId != me()
        && request.resource.data.updatedBy == me()
        && validGift(request.resource.data);
      allow update: if isFamily()
        && resource.data.recipientId != me()
        && unchanged('recipientId')
        && request.resource.data.updatedBy == me()
        && validGift(request.resource.data);
      allow delete: if isFamily() && resource.data.recipientId != me();
    }

    // Overheard notes. Never for the person they're about.
    match /ideas/{ideaId} {
      allow read: if isFamily() && resource.data.aboutId != me();
      allow create: if isFamily()
        && request.resource.data.aboutId != me()
        && request.resource.data.authorId == me()
        && validIdea(request.resource.data);
      allow update: if isFamily()
        && resource.data.aboutId != me()
        && unchanged('aboutId')
        && unchanged('authorId')
        && validIdea(request.resource.data);
      allow delete: if isFamily() && resource.data.aboutId != me();
    }
  }
}
